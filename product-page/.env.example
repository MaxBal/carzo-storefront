# Used by the Next.js server to read published Carzo content.
DIRECTUS_URL=https://directus-production-7c9b.up.railway.app
# Static token of the `Carzo API Reader` service user. It reads published storefront
# data and creates orders, but cannot read customer orders.
# Keep this server-side; never prefix it with NEXT_PUBLIC_.
DIRECTUS_READ_TOKEN=
# Optional: enables protected draft previews from Directus Studio.
DIRECTUS_PREVIEW_SECRET=
# Public site origin used for Directus Studio preview links.
SITE_URL=https://carzo-eight.vercel.app

# One-time schema administration only. Remove/rotate after setup.
DIRECTUS_ADMIN_TOKEN=

# Server-side Nova Poshta integration key.
NOVA_POSHTA_API_KEY=

# Server-side order notification delivery. Channel and recipients are selected in Directus.
TELEGRAM_BOT_TOKEN=

# Customer storage backend for loyalty lookup and post-order registration.
# Production stays on directus until the final Directus→Supabase delta sync and explicit cutover.
# Values: directus (default) | supabase. Invalid values fail fast — no silent switch.
CUSTOMER_STORE=directus

# Server-side Supabase project used when CUSTOMER_STORE=supabase.
# SUPABASE_SECRET_KEY is an elevated secret (sb_secret_...). Keep it server-side;
# never prefix it with NEXT_PUBLIC_ and never commit real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
